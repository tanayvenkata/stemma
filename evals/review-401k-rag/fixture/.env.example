# OpenRouter API Key (get yours at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM Backend: "local" for LM Studio, "openrouter" for cloud
LLM_BACKEND=openrouter

# Model preset: local_fast, local_complex, cloud_cheap, cloud_mini, cloud_free, cloud_120b
# Or use full model ID like "google/gemini-2.0-flash-001"
# Default: cloud_cheap for fast iteration (~$0.00003/call)
# Override with: LLM_MODEL=cloud_120b python src/run_eval.py
LLM_MODEL=cloud_cheap

# Model selection for RAG pipeline (tiered by complexity)
SIMPLE_MODEL=google/gemini-2.0-flash-001   # Fast, cheap for simple queries
COMPLEX_MODEL=openai/gpt-4o-mini           # Better reasoning for complex queries
JUDGE_MODEL=openai/gpt-4o-mini             # LLM-as-Judge for evaluation
